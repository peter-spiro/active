{
  "name": "active",
  "displayName": "Active",
  "description": "Shows files you have edited in an Explorer section called Active.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "search2View",
          "title": "Search-2",
          "icon": "media/search.svg"
        }
      ]
    },
    "views": {
      "search2View": [
        {
          "id": "search2",
          "name": "Search-2",
          "type": "webview",
          "contextualTitle": "Search-2",
          "icon": "$(search)",
          "visibility": "visible"
        }
      ],
      "explorer": [
        {
          "id": "stackLevels",
          "name": "Stack",
          "type": "webview",
          "contextualTitle": "Stack",
          "icon": "$(layers)",
          "visibility": "visible"
        },
        {
          "id": "localBranches",
          "name": "Branches",
          "type": "webview",
          "contextualTitle": "Branches",
          "icon": "$(git-branch)",
          "visibility": "visible"
        },
        {
          "id": "diffFiles",
          "name": "Diffs",
          "type": "webview",
          "contextualTitle": "Diffs",
          "icon": "$(diff)",
          "visibility": "visible"
        },
        {
          "id": "activeFiles",
          "name": "Recent",
          "type": "webview",
          "contextualTitle": "Recent",
          "icon": "$(history)",
          "visibility": "visible"
        },
        {
          "id": "favoriteFiles",
          "name": "Favorites",
          "type": "webview",
          "contextualTitle": "Favorites",
          "icon": "$(star-full)",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "activeFiles.showTree",
        "title": "Show as Tree",
        "category": "Active",
        "icon": "$(list-tree)"
      },
      {
        "command": "activeFiles.showList",
        "title": "Show as List",
        "category": "Active",
        "icon": "$(list-flat)"
      },
      {
        "command": "diffs.showTree",
        "title": "Show as Tree",
        "category": "Active",
        "icon": "$(list-tree)"
      },
      {
        "command": "diffs.showList",
        "title": "Show as List",
        "category": "Active",
        "icon": "$(list-flat)"
      },
      {
        "command": "diffs.refresh",
        "title": "Refresh",
        "category": "Active",
        "icon": "$(refresh)"
      },
      {
        "command": "diffs.collapseAll",
        "title": "Collapse All",
        "category": "Active",
        "icon": "$(collapse-all)"
      },
      {
        "command": "diffs.levelOn",
        "title": "Lower level branch",
        "category": "Active",
        "icon": {
          "light": "media/diff-level-on-light.svg",
          "dark": "media/diff-level-on-dark.svg"
        }
      },
      {
        "command": "diffs.levelOff",
        "title": "Lower level branch",
        "category": "Active",
        "icon": {
          "light": "media/diff-level-off-light.svg",
          "dark": "media/diff-level-off-dark.svg"
        }
      },
      {
        "command": "diffs.mainOn",
        "title": "Main branch",
        "category": "Active",
        "icon": {
          "light": "media/diff-main-on-light.svg",
          "dark": "media/diff-main-on-dark.svg"
        }
      },
      {
        "command": "diffs.mainOff",
        "title": "Main branch",
        "category": "Active",
        "icon": {
          "light": "media/diff-main-off-light.svg",
          "dark": "media/diff-main-off-dark.svg"
        }
      },
      {
        "command": "diffs.pickCommit",
        "title": "Diff from commit",
        "category": "Active",
        "icon": "$(git-commit)"
      },
      {
        "command": "diffs.returnToTip",
        "title": "Return to branch tip",
        "category": "Active",
        "icon": "$(arrow-up)"
      },
      {
        "command": "diffs.configureBase",
        "title": "Compare branch",
        "category": "Active",
        "icon": "$(gear)"
      },
      {
        "command": "activeFiles.openDiff",
        "title": "Open Diff",
        "category": "Active",
        "icon": "$(diff)"
      },
      {
        "command": "activeFiles.openFile",
        "title": "Open File",
        "category": "Active"
      },
      {
        "command": "activeFiles.refresh",
        "title": "Refresh",
        "category": "Active",
        "icon": "$(refresh)"
      },
      {
        "command": "activeFiles.collapseAll",
        "title": "Collapse All",
        "category": "Active",
        "icon": "$(collapse-all)"
      },
      {
        "command": "activeFiles.clear",
        "title": "Clear List",
        "category": "Active",
        "icon": "$(clear-all)"
      },
      {
        "command": "activeFiles.remove",
        "title": "Remove from Recent",
        "icon": "$(close)"
      },
      {
        "command": "favorites.addOpen",
        "title": "Add to Favorites",
        "category": "Active",
        "icon": "$(star-empty)"
      },
      {
        "command": "favorites.removeOpen",
        "title": "Remove from Favorites",
        "category": "Active",
        "icon": "$(star-full)"
      },
      {
        "command": "favorites.addFolder",
        "title": "Add to Favorites",
        "category": "Active",
        "icon": "$(star-empty)"
      },
      {
        "command": "favorites.pickFolder",
        "title": "Add Folder",
        "category": "Active",
        "icon": "$(folder)"
      },
      {
        "command": "stack.add",
        "title": "New Branch",
        "icon": "$(add)"
      },
      {
        "command": "stack.unstack",
        "title": "Unstack",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "stack.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "branches.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "branches.pare",
        "title": "Pare",
        "icon": {
          "light": "media/pare-light.svg",
          "dark": "media/pare-dark.svg"
        }
      },
      {
        "command": "search2.refresh",
        "title": "Refresh",
        "category": "Active",
        "icon": "$(refresh)"
      },
      {
        "command": "search2.show",
        "title": "Search-2",
        "category": "Active",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stack.add",
          "when": "view == stackLevels",
          "group": "navigation@1"
        },
        {
          "command": "stack.unstack",
          "when": "view == stackLevels",
          "group": "navigation@2"
        },
        {
          "command": "stack.refresh",
          "when": "view == stackLevels",
          "group": "navigation@3"
        },
        {
          "command": "branches.pare",
          "when": "view == localBranches",
          "group": "navigation@1"
        },
        {
          "command": "branches.refresh",
          "when": "view == localBranches",
          "group": "navigation@2"
        },
        {
          "command": "diffs.levelOn",
          "when": "view == diffFiles && diffs.hasStackParent && diffs.base == parent",
          "group": "navigation@0"
        },
        {
          "command": "diffs.levelOff",
          "when": "view == diffFiles && diffs.hasStackParent && diffs.base == main",
          "group": "navigation@0"
        },
        {
          "command": "diffs.mainOn",
          "when": "view == diffFiles && diffs.hasStackParent && diffs.base == main",
          "group": "navigation@1"
        },
        {
          "command": "diffs.mainOff",
          "when": "view == diffFiles && diffs.hasStackParent && diffs.base == parent",
          "group": "navigation@1"
        },
        {
          "command": "diffs.pickCommit",
          "when": "view == diffFiles",
          "group": "navigation@2"
        },
        {
          "command": "diffs.returnToTip",
          "when": "view == diffFiles && diffs.viewingCommit",
          "group": "navigation@3"
        },
        {
          "command": "diffs.showTree",
          "when": "view == diffFiles && diffsLayout == list",
          "group": "navigation@4"
        },
        {
          "command": "diffs.showList",
          "when": "view == diffFiles && diffsLayout == tree",
          "group": "navigation@4"
        },
        {
          "command": "diffs.refresh",
          "when": "view == diffFiles",
          "group": "navigation@5"
        },
        {
          "command": "diffs.collapseAll",
          "when": "view == diffFiles && diffsLayout == tree",
          "group": "navigation@6"
        },
        {
          "command": "diffs.configureBase",
          "when": "view == diffFiles",
          "group": "navigation@7"
        },
        {
          "command": "activeFiles.showTree",
          "when": "view == activeFiles && activeFilesLayout == list",
          "group": "navigation@1"
        },
        {
          "command": "activeFiles.showList",
          "when": "view == activeFiles && activeFilesLayout == tree",
          "group": "navigation@1"
        },
        {
          "command": "activeFiles.collapseAll",
          "when": "view == activeFiles && activeFilesLayout == tree",
          "group": "navigation@2"
        },
        {
          "command": "activeFiles.refresh",
          "when": "view == activeFiles",
          "group": "navigation@3"
        },
        {
          "command": "activeFiles.clear",
          "when": "view == activeFiles",
          "group": "navigation@4"
        },
        {
          "command": "favorites.addOpen",
          "when": "view == favoriteFiles && favorites.canAdd",
          "group": "navigation"
        },
        {
          "command": "favorites.pickFolder",
          "when": "view == favoriteFiles",
          "group": "navigation@1"
        },
        {
          "command": "search2.refresh",
          "when": "view == search2",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "favorites.addFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "favorites.addOpen",
          "when": "!favorites.active && (resourceScheme == file || resourceScheme == vscode-remote || resourceScheme == vscode-vfs)",
          "group": "navigation"
        },
        {
          "command": "favorites.removeOpen",
          "when": "favorites.active && (resourceScheme == file || resourceScheme == vscode-remote || resourceScheme == vscode-vfs)",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "activeFiles.remove",
          "when": "view == activeFiles && viewItem == activeFile",
          "group": "inline"
        },
        {
          "command": "activeFiles.remove",
          "when": "view == activeFiles && viewItem == activeFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "activeFiles.showTree",
          "when": "activeFilesLayout != tree"
        },
        {
          "command": "activeFiles.showList",
          "when": "activeFilesLayout != list"
        },
        {
          "command": "diffs.showTree",
          "when": "diffsLayout != tree"
        },
        {
          "command": "diffs.showList",
          "when": "diffsLayout != list"
        },
        {
          "command": "diffs.refresh",
          "when": "false"
        },
        {
          "command": "diffs.collapseAll",
          "when": "false"
        },
        {
          "command": "diffs.levelOn",
          "when": "false"
        },
        {
          "command": "diffs.levelOff",
          "when": "false"
        },
        {
          "command": "diffs.mainOn",
          "when": "false"
        },
        {
          "command": "diffs.mainOff",
          "when": "false"
        },
        {
          "command": "diffs.pickCommit",
          "when": "false"
        },
        {
          "command": "diffs.returnToTip",
          "when": "false"
        },
        {
          "command": "diffs.configureBase",
          "when": "false"
        },
        {
          "command": "activeFiles.collapseAll",
          "when": "false"
        },
        {
          "command": "activeFiles.openDiff",
          "when": "false"
        },
        {
          "command": "activeFiles.openFile",
          "when": "false"
        },
        {
          "command": "activeFiles.remove",
          "when": "false"
        },
        {
          "command": "favorites.addOpen",
          "when": "favorites.canAdd"
        },
        {
          "command": "favorites.removeOpen",
          "when": "favorites.active"
        },
        {
          "command": "favorites.addFolder",
          "when": "false"
        },
        {
          "command": "stack.add",
          "when": "false"
        },
        {
          "command": "stack.unstack",
          "when": "false"
        },
        {
          "command": "stack.refresh",
          "when": "false"
        },
        {
          "command": "branches.refresh",
          "when": "false"
        },
        {
          "command": "branches.pare",
          "when": "false"
        },
        {
          "command": "search2.refresh",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "activeFiles",
        "contents": "Edit a file and it will show up here."
      },
      {
        "view": "diffFiles",
        "contents": "No files have changed since this branch left main."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "install-cursor": "npm run compile && node scripts/install-cursor.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4"
  }
}
